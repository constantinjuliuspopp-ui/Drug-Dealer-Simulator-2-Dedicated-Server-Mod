# DDS2 Multiplayer Mod – Server-Konfiguration (DDS2Server.exe)
# Kommandozeilen-Parameter überschreiben diese Werte, z. B.:
#   DDS2Server.exe --port 7777 --maxplayers 2 --world "Welt1"

ServerName=Mein DDS2 Server
# Spielport (UDP). In Router und Firewall freigeben.
Port=7777
# Abfrage-Port (UDP) für Ping, Spielerzahl, Version und Passwortprüfung. 0 = Spielport + 1 (also 7778).
# Ebenfalls freigeben, sonst sehen Mitspieler den Server als "offline" (Verbinden geht trotzdem).
QueryPort=0
# Mitspieler (ohne den Server selbst). Das Spiel ist für 3 Spieler ausgelegt: Server + 2.
# Höhere Werte sind experimentell.
MaxPlayers=2
# Leer lassen für keinen Passwortschutz.
Password=
# Welt, die der Server lädt: Ordnername unter
# %LOCALAPPDATA%\DrugDealerSimulator2\Saved\SaveGames\Cartels (oder der Name im Spiel).
# Leer = die zuletzt gespielte Welt.
World=
# Autosave-Intervall in Minuten, 0 = aus.
AutosaveMinutes=10
# true = Spiel ohne Fenster und Grafik starten. Klappt das nicht, startet der Server es
# automatisch einmal mit kleinem Fenster. false = immer mit Fenster.
Headless=true
# Nach einem Absturz des Spiels automatisch neu starten (höchstens 3x in 10 Minuten).
AutoRestart=true
# Spiel-Takte pro Sekunde. Ohne Grafik rechnet das Spiel sonst so schnell es kann und braucht unnötig CPU.
# 30 ist ein üblicher Wert für Server, 0 = unbegrenzt.
TickRate=30
# Läuft Steam nicht, startet der Server es unsichtbar und wartet auf die Anmeldung.
# Dafür einmal von Hand mit dem Server-Konto anmelden und "Angemeldet bleiben" anhaken.
StartSteam=true
# Spielordner (mit DrugDealerSimulator2.exe). Leer = automatisch über Steam suchen.
# Bei Installation per SteamCMD hier den Ordner eintragen.
GameDir=
