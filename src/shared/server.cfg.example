# DDS2 Multiplayer Mod – Server-Konfiguration
# Kommandozeilen-Parameter (--port, --maxplayers, --world) überschreiben diese Werte.

ServerName=Mein DDS2 Server
Port=7777
# Das Spiel ist für 3 Spieler ausgelegt. Höhere Werte sind experimentell.
# Im Pseudo-Dedicated-Modus belegt der Host selbst einen Platz.
MaxPlayers=3
# Leer lassen für keinen Passwortschutz.
Password=
# Welt, die der Server lädt: Ordnername unter
# %LOCALAPPDATA%\DrugDealerSimulator2\Saved\SaveGames\Cartels (oder der Name im Spiel).
# Leer = die zuletzt gespielte Welt.
World=
# Autosave-Intervall in Minuten, 0 = aus.
AutosaveMinutes=10
