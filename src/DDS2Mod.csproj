<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DDS2Mod</RootNamespace>
    <AssemblyName>DDS2Mod</AssemblyName>
    <Product>DDS2 Multiplayer Mod</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="shared\DDS2Net\**" />
    <!-- Der Server ist ein eigenes Projekt (server\DDS2Server.csproj). -->
    <Compile Remove="server\**" />
    <None Remove="server\**" />
    <!-- Ebenso das Relay (relay\DDS2Relay.csproj). -->
    <Compile Remove="relay\**" />
    <None Remove="relay\**" />
    <EmbeddedResource Include="shared\version.json" LogicalName="DDS2Mod.version.json" />
  </ItemGroup>

</Project>
